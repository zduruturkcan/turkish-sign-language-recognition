# --- Dataset ---
# The AUTSL videos are downloaded from Kaggle by the notebook itself. Not included:
# not redistributable, and far too large for a git repo anyway.
autsl_data/
autsl.zip

# --- Generated arrays / models ---
# Regenerated by running the notebook (landmark extraction results, trained model
# weights, saved metrics). Excluded to keep the repo small and avoid committing
# stale copies that drift from the code that produced them.
*.npy
*.pt
*.task
metrics.json

# --- Credentials ---
# Safety net: a Kaggle API token should never be committed to the repo. The
# notebook stores it on Google Drive, not locally, but this catches it in case
# it ever ends up in the project folder.
kaggle.json

# --- Jupyter / Python housekeeping ---
.ipynb_checkpoints/
__pycache__/
*.pyc

# --- OS junk ---
.DS_Store
Thumbs.db
